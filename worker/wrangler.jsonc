{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arcanum-neon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://arcanumrpg.vercel.app"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "91b07552eafb4a9780acdfb1b5e800a8"
    }
  ]
}
